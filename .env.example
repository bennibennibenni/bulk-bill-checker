# Port Server
PORT=3000

# Mode Operasi: LIVE atau SIMULATOR
BILLER_MODE=LIVE

# Kredensial PPOB Gateway (Jika ingin menggunakan provider live seperti Digiflazz / Alterra / Tripay)
# PPOB_PROVIDER=DIGIFLAZZ
# DIGIFLAZZ_USERNAME=your_username
# DIGIFLAZZ_API_KEY=your_production_key
# TRIPAY_API_KEY=your_tripay_key
